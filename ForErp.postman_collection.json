{
  "info": {
    "name": "ForErp API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userName", "value": "Ivan" },
    { "key": "lastName", "value": "Ivanov" },
    { "key": "email", "value": "ivan@example.com" },
    { "key": "userId", "value": "1" },
    { "key": "itemName", "value": "Laptop" },
    { "key": "itemPrice", "value": "1200" }
  ],
  "item": [
    {
      "name": "01 CreateAccount",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/CreateAccount",
        "body": {"mode":"raw","raw":"{\n  \"user_name\": \"{{userName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"email\": \"{{email}}\"\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 200 or 409', function () { pm.expect([200, 409]).to.include(pm.response.code); });",
        "pm.test('Response is JSON', function () { pm.response.to.have.header('Content-Type'); });",
        "const json = pm.response.json();",
        "pm.test('Has response and succes fields', function () { pm.expect(json).to.have.property('response'); pm.expect(json).to.have.property('succes'); });",
        "pm.test('succes is boolean', function () { pm.expect(json.succes).to.be.a('boolean'); });"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "02 Avtorizacion",
      "request": {
        "method": "GET",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/Avtorizacion",
        "body": {"mode":"raw","raw":"{\n  \"user_name\": \"{{userName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"email\": \"{{email}}\"\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 200 or 400', function () { pm.expect([200, 400]).to.include(pm.response.code); });",
        "const json = pm.response.json();",
        "pm.test('Has response and succes fields', function () { pm.expect(json).to.have.property('response'); pm.expect(json).to.have.property('succes'); });",
        "pm.test('succes is boolean', function () { pm.expect(json.succes).to.be.a('boolean'); });"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "03 CreateBuy",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/CreateBuy",
        "body": {"mode":"raw","raw":"{\n  \"user_id\": {{userId}},\n  \"item_name\": \"{{itemName}}\",\n  \"item_price\": {{itemPrice}}\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 202', function () { pm.response.to.have.status(202); });",
        "pm.test('Empty body is acceptable', function () { pm.expect(pm.response.text()).to.be.oneOf(['', 'null']); });"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "04 ShowAllItems",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw":"{{baseUrl}}/ShowAllItems?user_id={{userId}}","host":["{{baseUrl}}"],"path":["ShowAllItems"],"query":[{"key":"user_id","value":"{{userId}}"}]}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "const json = pm.response.json();",
        "pm.test('Response is array', function () { pm.expect(json).to.be.an('array'); });",
        "if (json.length > 0) { pm.test('Cart item has item_name and item_price', function () { pm.expect(json[0]).to.have.property('item_name'); pm.expect(json[0]).to.have.property('item_price'); }); }"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "05 ChangePrice",
      "request": {
        "method": "PATCH",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/ChangePrice",
        "body": {"mode":"raw","raw":"{\n  \"item_name\": \"{{itemName}}\",\n  \"item_price\": 1500\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 202', function () { pm.response.to.have.status(202); });"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "06 DeleteBuyFromKorzina",
      "request": {
        "method": "DELETE",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/DeleteBuyFromKorzina",
        "body": {"mode":"raw","raw":"{\n  \"user_id\": {{userId}},\n  \"item_name\": \"{{itemName}}\"\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 202', function () { pm.response.to.have.status(202); });"
      ],"type":"text/javascript"}}]
    },
    {
      "name": "07 DeleteAccount",
      "request": {
        "method": "DELETE",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": "{{baseUrl}}/DeleteAccount",
        "body": {"mode":"raw","raw":"{\n  \"user_name\": \"{{userName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"email\": \"{{email}}\"\n}"}
      },
      "event": [{"listen":"test","script":{"exec":[
        "pm.test('Status is 200 or 404', function () { pm.expect([200, 404]).to.include(pm.response.code); });",
        "const json = pm.response.json();",
        "pm.test('Has response and succes fields', function () { pm.expect(json).to.have.property('response'); pm.expect(json).to.have.property('succes'); });",
        "pm.test('succes is boolean', function () { pm.expect(json.succes).to.be.a('boolean'); });"
      ],"type":"text/javascript"}}]
    }
  ]
}
